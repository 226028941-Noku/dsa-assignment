public class InsertionSort {
/* function to sort array using insertion sort */
void sort(int arr[]) 
{
    int n = arr.length;
for (int i = 1; i < n; i++) {
int key = arr[i];
int j = i - 1;

/*move elements greater than key one position ahead//
while (j >= 0 && arr[j] > key) {
   comparisons++; //count the comparison that caused a shift//
   arr[j + 1] = arr[j];
   shifts++;
   j--;
}
/*if loop ended because j < 0, no comparison was wasted but if it ended because arr[j] <= key, count that final check too*/
if (j >= 0) {
   comparisons++;
}
arr[j + 1] = key;
//show state after pass 1,2,3 (i = 1,2,3) 
if (i <= 3) {
    System.out.print("After pass " + i + " ; ");
printArray(arr);
  }
}
System.out.println("Total comparisons: " + comparisons);
System.out.printl("Total shifts: " + shifts);
}
static void printArray(int[] arr) {
    for (int val : arr) { 
        System.out.print(val + " " ); 
 }
        System.out.println();
}

