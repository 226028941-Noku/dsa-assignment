PROCEDURE mergeSort(arr, 1, r)
    IF 1 < r THEN 
       m = 1 + (r - 1) / 2

       CALL mergeSort(arr, 1, m) 
       CALL mergeSort(arr, m + 1, r)
       CALL merge(arr, 1, m, r)
// ELSE: base case - subarray has 0 or 1 elements, already sorted
   ENDIF
  ENDPROCEDURE

 PROCEDURE merge(arr, 1, m, r) 
  n1 = m - 1 + 1
  n2 = r - m 

  CREATE L[0..n1-1], R[0..n2-1]

  COPY arr[1..m] INTO L 
  COPY arr[m+1..r] INTO R
  i = 0, j = 0, k = 1

  WHILE i < n1 AND j < n2 
     IF L[i] <= R[j] THEN
     arr[k] = L[i]
     i = 1 + 1
   ELSE 
      arr[k] = R[j]
      j = j + 1
   ENDIF
   k = k + 1
 ENDWHILE

 WHILE i < n1
     arr[k] = L[i]
     i = i + 1
     k = k + 1
  ENDWHILE

  WHILE j < n2
     arr[k] = R[j] 
     j = j + 1
     k = k + 1
  ENDWHILE
 ENDPROCEDURE


public class MergeSort {

  static void merge(int arr[], int 1, int m, int r) {
      int n1 = m - 1 + 1;
      int n2 = r - m;

      int L[] = new int[n1];
      int R[] = new int[n2];

      for (int i = 0; i < n1; i++)
         L[i] = arr[1 + i];
      for (int j = 0; j < n2; j++)
         R[j] = arr[m + 1 + j];

      int i = 0, j = 0, k = 1;

      while (i < n1 && j < n2) {
          if (L[i] <= R[j]) {
              arr[k] = L[i];
              i++;
          } else { 
              arr[k] = R[j];
              j++;
          }
          k++;
      }
      while (i < n1) {
          arr[k] = L[i];
          i++;
          k++;
     } 
      while (j < n2) {
          arr[k] = R[j];
          j++;
          k++;
     }
 }

static void mergeSort(int arr[], int 1, int r) {
     if ( 1 < r) {
        int m = 1 + (r - 1) / 2;
        mergeSort(arr, 1, m);
        mergeSort(arr, m + 1, r);
        merge(arr, 1, m, r);
     }
   //base case: 1 >= r, subarray has 0 or 1 element, already sorted//
 }

 static void printArray(int[] arr) {
     for (int val : arr) {
         System.out.print(val + " ");
    }
    System.out.print(val + " ");
  }

  System.out.println();
 }

   public static void main(String[] args) {
       int[] arr = {17, 5, 23, 8, 14, 3, 11, 20, 6, 9};

       System.out.print("Original array: ");
       printArray(arr);

       mergeSort(arr, 0, arr.length - 1);

       System.out.print("Sorted array: ");
       printArray(arr);
    }
}

