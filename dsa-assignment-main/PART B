          IF low < high THEN
          pi = CALL partition(arr, low, high)
          CALL quickSOrt(arr, low, pi - 1)
          CALL quiclsort(arr, pi + 1, high)
      //ELSE: base case - 0 or 1 elements, already sorted
      ENDIF
